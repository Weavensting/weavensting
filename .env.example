# Copy to .env and fill in. Metro inlines EXPO_PUBLIC_* at build time, so only
# put values here that are safe inside a shipped app bundle.
#
# The Supabase anon key is safe: row-level security decides what it can reach.
# OAuth client IDs are public identifiers by design.
# Your Claude API key is NOT — it belongs in the Edge Function's secrets, set
# with `supabase secrets set ANTHROPIC_API_KEY=...`. See docs/setup.md.

# ── Required ────────────────────────────────────────────────────────────────
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Bundle identifiers are unique across the whole Apple developer programme, so
# the default is very likely taken. Make this yours before the first build —
# changing it later means a new App ID and re-doing the Apple setup.
BUNDLE_ID=com.yourname.familycookbook

# ── Google sign-in (optional) ───────────────────────────────────────────────
# Leave these out for an Apple-only build: the Google plugin and its URL scheme
# are then left out of the build entirely, and the button does not render.
#
# The WEB client ID is the audience Supabase validates against and is needed on
# every platform, including iOS.
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=000000000000-xxxx.apps.googleusercontent.com
# iOS only. Its reversed form is derived automatically for the URL scheme.
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=000000000000-yyyy.apps.googleusercontent.com
#
# Android needs no client ID here: Google matches the app by package name and
# signing-certificate SHA-1 instead. Register a fingerprint for every build
# type you use (debug, EAS development, EAS production, Play Store re-signing)
# or sign-in fails in exactly the ones you missed.
